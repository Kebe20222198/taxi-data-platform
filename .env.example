# ==============================================================================
# NYC Taxi Data Platform — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ==============================================================================

# ── MinIO (S3-compatible Object Storage / Data Lake) ─────────────────────────
MINIO_ROOT_USER=changeme_minio_user
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
# Endpoint for host-side scripts (outside Docker network)
MINIO_ENDPOINT_HOST=http://localhost:9000
AWS_ACCESS_KEY_ID=changeme_minio_user
AWS_SECRET_ACCESS_KEY=changeme_minio_password
AWS_REGION=us-east-1

# ── PostgreSQL (Airflow metadata + DWH backend) ─────────────────────────────
POSTGRES_USER=changeme_pg_user
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# ── Apache Spark 3.5 ────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_WEBUI_PORT=8085
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ── Apache Airflow 3.2.2 ───────────────────────────────────────────────────
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.2-python3.11
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=changeme_airflow_user
_AIRFLOW_WWW_USER_PASSWORD=changeme_airflow_password
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_python_cryptography_fernet

# ── Dedicated Airflow Metadata Database (PostgreSQL) ─────────────────────────
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=changeme_airflow_pg_password
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PORT=5433

# ── Metabase & Streamlit Dashboard ───────────────────────────────────────────
METABASE_PORT=3000
DASHBOARD_PORT=8501

# ── Ingestion ────────────────────────────────────────────────────────────────
NYC_TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
NYC_TLC_REFERENCE_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
