# ==============================================================================
# NYC Taxi Data Platform — .gitignore
# ==============================================================================

# ── Data files (Parquet files are 800MB+) ────────────────────────────────────
data/*
!data/sample/
!data/sample/**
*.parquet
*.csv
!data/sample/*.parquet
!data/sample/*.csv
!dbt/seeds/*.csv

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
*.pyc
pip-log.txt
pip-delete-this-directory.txt

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.production

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Airflow ──────────────────────────────────────────────────────────────────
logs/
airflow.cfg
airflow.db
webserver_config.py

# ── dbt ──────────────────────────────────────────────────────────────────────
target/
dbt_packages/
dbt_modules/
.user.yml
*/.user.yml

# ── Spark / Metabase ─────────────────────────────────────────────────────────
metabase.db*
metabase-data/
metastore_db/
derby.log
spark-warehouse/

# ── Coverage & Testing ──────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/
